  "peerDependencies": {
    "@pnpm/logger": "^1001.0.1"
  },
  "devDependencies": {
    "@types/is-windows": "^1.0.2",
    "@pnpm/logger": "1001.0.1",
    "@pnpm/types": "1001.3.1",
    "@pnpm/worker": "1000.6.11"
  },
  "engines": {
    "node": ">=18.12"
  },
  "jest": {
    "preset": "@pnpm/jest-config"
