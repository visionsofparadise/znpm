    "@pnpm/fs.hard-link-dir": "1000.0.6",
    "@pnpm/error": "1000.1.0",
    "@pnpm/graceful-fs": "1000.1.0",
    "@pnpm/store.cafs": "1000.1.6",
    "@pnpm/symlink-dependency": "1000.0.20"
